<?xml version="1.0" encoding="UTF-8"?>
<!--
  Tests that need the real MySQL schema (e.g. TransferConcurrencyTest).
  Host, port, user and password come from .env; only the database is forced here,
  so this never touches the dev database (infruity_clone).

  One-time setup: create an empty database named infruity_test (utf8mb4), then
    DB_DATABASE=infruity_test APP_ENV=testing php artisan migrate
  (add the force flag when prompted).

  Run:
    php vendor/bin/phpunit -c phpunit.mysql.xml
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="./vendor/phpunit/phpunit/phpunit.xsd"
         backupGlobals="false"
         backupStaticAttributes="false"
         bootstrap="vendor/autoload.php"
         colors="true"
         convertErrorsToExceptions="true"
         convertNoticesToExceptions="true"
         convertWarningsToExceptions="true"
         processIsolation="false"
         stopOnFailure="false">
    <testsuites>
        <testsuite name="MySQL">
            <file>./tests/Feature/TransferConcurrencyTest.php</file>
            <file>./tests/Feature/LoginAccessBehaviorTest.php</file>
            <file>./tests/Feature/PosPaymentBehaviorTest.php</file>
            <file>./tests/Feature/TransferStockBehaviorTest.php</file>
            <file>./tests/Feature/ReportBehaviorTest.php</file>
            <file>./tests/Feature/WholesaleBehaviorTest.php</file>
            <file>./tests/Feature/LegacyImportTest.php</file>
            <file>./tests/Feature/ProductHppFractionTest.php</file>
            <file>./tests/Feature/StockOpnameBehaviorTest.php</file>
        </testsuite>
    </testsuites>
    <groups>
        <exclude>
            <group>known-gap</group>
        </exclude>
    </groups>
    <php>
        <ini name="memory_limit" value="512M"/>
        <server name="APP_ENV" value="testing"/>
        <server name="BCRYPT_ROUNDS" value="4"/>
        <server name="CACHE_DRIVER" value="array"/>
        <server name="DB_CONNECTION" value="mysql"/>
        <server name="DB_DATABASE" value="infruity_test"/>
        <server name="MAIL_DRIVER" value="array"/>
        <server name="QUEUE_CONNECTION" value="sync"/>
        <server name="SESSION_DRIVER" value="array"/>
    </php>
</phpunit>
