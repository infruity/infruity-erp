{
    "private": true,
    "engines": {
        "node": "^20.19.0 || >=22.12.0"
    },
    "scripts": {
        "dev": "vite",
        "dev:vendor": "vite build --mode vendor --watch",
        "clean": "node -e \"require('fs').rmSync('public/build/assets',{recursive:true,force:true})\"",
        "build": "npm run clean && vite build && vite build --mode vendor",
        "test:js": "node --test tests/js/*.test.cjs"
    },
    "devDependencies": {
        "autoprefixer": "^10.6.2",
        "laravel-vite-plugin": "^3.2.1",
        "postcss": "^8.5.32",
        "tailwindcss": "^3.4.19",
        "vite": "^8.3.5"
    },
    "dependencies": {
        "@alpinejs/anchor": "^3.17.5",
        "@alpinejs/collapse": "^3.17.5",
        "alpinejs": "^3.17.5",
        "datatables.net": "1.13.7",
        "flatpickr": "4.6.13",
        "jquery": "^3.7.1",
        "sweetalert2": "^11.26.25"
    }
}
