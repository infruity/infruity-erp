{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "barryvdh/laravel-dompdf": "^3.1",
        "google/apiclient": "^2.18",
        "guzzlehttp/guzzle": "^8.3",
        "laravel-notification-channels/webpush": "^13.0",
        "laravel/framework": "^13.0",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^3.0",
        "livewire/livewire": "^4.0",
        "maatwebsite/excel": "^4.0",
        "mews/captcha": "^3.4",
        "milon/barcode": "^13.5",
        "nwidart/laravel-modules": "^13.0",
        "rap2hpoutre/laravel-log-viewer": "^3.1",
        "simplesoftwareio/simple-qrcode": "^4.2",
        "spatie/laravel-html": "^3.13",
        "symfony/mailer": "^7.0",
        "yajra/laravel-datatables-oracle": "^13.0"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.4",
        "fakerphp/faker": "^1.9.1",
        "laravel/ui": "^4.0",
        "mockery/mockery": "^1.4",
        "nunomaduro/collision": "^8.9",
        "phpunit/phpunit": "^12.5",
        "spatie/laravel-ignition": "^2.12"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "wikimedia/composer-merge-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Modules\\": "Modules/"
        },
        "files": [
            "app/Helpers/DateHelper.php",
            "app/Helpers/Random.php",
            "app/Helpers/SlackHelper.php"
        ],
        "classmap": [
            "database/seeds",
            "database/factories"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    }
}
